---
interface Props {
  label: string;
  caption?: string;
  images: {
    src: string;
    alt: string;
    orientation: "horizontal" | "vertical";
  }[];
}

const { label, caption, images } = Astro.props;
---

<figure class="recipe-mosaic mt-6" aria-label={label}>
  <div class="grid grid-cols-2 gap-3">
    {
      images.map((image) => (
        <img
          src={image.src}
          alt={image.alt}
          class={
            image.orientation === "horizontal"
              ? "aspect-[4/3] w-full rounded-lg object-cover"
              : "aspect-[3/4] w-full rounded-lg object-cover"
          }
          loading="lazy"
        />
      ))
    }
  </div>
  {
    caption && (
      <figcaption class="mt-3 text-center text-sm italic text-warm-700">
        {caption}
      </figcaption>
    )
  }
</figure>
