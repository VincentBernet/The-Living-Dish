---
interface Props {
  steps: string[];
  locale: "fr" | "en";
  stepImages?: {
    afterStep: number;
    label: string;
    images: {
      src: string;
      alt: string;
      orientation: "horizontal" | "vertical";
    }[];
  }[];
}

const { steps, stepImages = [] } = Astro.props;
---

<ol class="space-y-4">
  {
    steps.map((step, index) => (
      <li class="flex gap-4">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent text-sm font-bold text-white">
          {index + 1}
        </span>
        <div class="min-w-0 flex-1">
          <p class="pt-1 text-warm-800 leading-relaxed">{step}</p>
          {stepImages
            .filter((mosaic) => mosaic.afterStep === index + 1)
            .map((mosaic) => (
              <div class="recipe-mosaic mt-4" aria-label={mosaic.label}>
                <div class="grid grid-cols-2 gap-3">
                  {mosaic.images.map((image) => (
                    <img
                      src={image.src}
                      alt={image.alt}
                      class={
                        image.orientation === "horizontal"
                          ? "aspect-[4/3] w-full rounded-lg object-cover"
                          : "aspect-[3/4] w-full rounded-lg object-cover"
                      }
                      loading="lazy"
                    />
                  ))}
                </div>
              </div>
            ))}
        </div>
      </li>
    ))
  }
</ol>
