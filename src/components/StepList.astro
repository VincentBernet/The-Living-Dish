---
import ImageMosaic from "./ImageMosaic.astro";

interface Props {
  steps: string[];
  locale: "fr" | "en";
  stepImages?: {
    afterStep: number;
    label: string;
    images: {
      src: string;
      alt: string;
      orientation: "horizontal" | "vertical";
    }[];
  }[];
}

const { steps, stepImages = [] } = Astro.props;
---

<ol class="space-y-4">
  {
    steps.map((step, index) => (
      <li class="flex gap-4">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent text-sm font-bold text-white">
          {index + 1}
        </span>
        <div class="min-w-0 flex-1">
          <p class="pt-1 text-warm-800 leading-relaxed">{step}</p>
          {stepImages
            .filter((mosaic) => mosaic.afterStep === index + 1)
            .map((mosaic) => (
              <ImageMosaic label={mosaic.label} images={mosaic.images} />
            ))}
        </div>
      </li>
    ))
  }
</ol>
