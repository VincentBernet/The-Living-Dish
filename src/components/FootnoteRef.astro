---
interface Props {
  id: string;
  label: string;
  marker?: string;
  ariaLabel?: string;
}

const {
  id,
  label,
  marker = "*",
  ariaLabel = `${label}, voir la note`,
} = Astro.props;
const referenceId = `footnote-ref-${id}`;
const noteId = `footnote-${id}`;
---

<a
  id={referenceId}
  href={`#${noteId}`}
  class="recipe-footnote-reference"
  aria-label={ariaLabel}
>
  {label}{marker}
</a>
