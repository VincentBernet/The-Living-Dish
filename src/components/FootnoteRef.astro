---
interface Props {
  id: string;
  label: string;
  marker?: string;
  ariaLabel?: string;
  referenceId?: string;
}

const {
  id,
  label,
  marker = "*",
  ariaLabel = `${label}, voir la note`,
  referenceId = `footnote-ref-${id}`,
} = Astro.props;
const noteId = `footnote-${id}`;
---

{label}<a
  id={referenceId}
  href={`#${noteId}`}
  class="recipe-footnote-reference"
  aria-label={ariaLabel}
>
  {marker}
</a>
