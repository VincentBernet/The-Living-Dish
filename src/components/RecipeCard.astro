---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../lib/recipes";
import { getSlugFromId } from "../lib/recipes";
import RecipeCardMedia from "./RecipeCardMedia.astro";

interface Props {
  recipe: CollectionEntry<"recipes">;
  locale: Locale;
}

const { recipe, locale } = Astro.props;
const slug = getSlugFromId(recipe.id);

const difficultyLabels = {
  fr: { easy: "Facile", medium: "Moyen", hard: "Difficile" },
  en: { easy: "Easy", medium: "Medium", hard: "Hard" },
};
---

<a
  href={`/${locale}/recipes/${slug}`}
  class="group block overflow-hidden rounded-lg border border-warm-200 bg-white shadow-sm hover:shadow-md hover:border-accent/30 transition-all"
>
  <RecipeCardMedia image={recipe.data.image} />
  <div class="p-6">
    <h2
      class="text-xl font-serif font-bold text-warm-900 group-hover:text-accent transition-colors"
    >
      {recipe.data.title}
    </h2>
    <p class="mt-2 text-sm text-warm-800 line-clamp-2">
      {recipe.data.description}
    </p>
    <div class="mt-4 flex flex-wrap gap-3 text-xs text-warm-800">
      <span>{recipe.data.prepTime + recipe.data.cookTime} min</span>
      <span>&middot;</span>
      <span>
        {recipe.data.servings}
        {locale === "fr" ? "portions" : "servings"}
      </span>
      <span>&middot;</span>
      <span>{difficultyLabels[locale][recipe.data.difficulty]}</span>
    </div>
  </div>
</a>
