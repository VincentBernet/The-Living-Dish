---
import { render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import StepList from "../../../components/StepList.astro";
import LanguageSwitcher from "../../../components/LanguageSwitcher.astro";
import ServingsScaler from "../../../components/ServingsScaler";
import {
  getRecipesByLocale,
  getAlternateRecipe,
  getSlugFromId,
} from "../../../lib/recipes";

const locale = "fr";

export async function getStaticPaths() {
  const recipes = await getRecipesByLocale("fr");
  return recipes.map((recipe) => ({
    params: { slug: getSlugFromId(recipe.id) },
  }));
}

const { slug } = Astro.params;
const recipes = await getRecipesByLocale(locale);
const recipe = recipes.find((entry) => getSlugFromId(entry.id) === slug);

if (!recipe) {
  return Astro.redirect(`/${locale}/`);
}

const { Content } = await render(recipe);
const alternateRecipe = await getAlternateRecipe(recipe, "en");

const difficultyLabels = {
  easy: "Facile",
  medium: "Moyen",
  hard: "Difficile",
};
---

<Layout
  title={`${recipe.data.title} — Blog Cuisine`}
  description={recipe.data.description}
  locale={locale}
>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <div class="mb-6">
      <LanguageSwitcher
        currentLocale={locale}
        alternateRecipe={alternateRecipe}
      />
    </div>

    <header class="mb-10">
      <h1 class="text-4xl font-serif font-bold text-warm-900">
        {recipe.data.title}
      </h1>
      <p class="mt-3 text-lg text-warm-800">{recipe.data.description}</p>
      <div class="mt-4 flex flex-wrap gap-4 text-sm text-warm-800">
        <span>Préparation : {recipe.data.prepTime} min</span>
        <span>Cuisson : {recipe.data.cookTime} min</span>
        <span>{recipe.data.servings} portions</span>
        <span>{difficultyLabels[recipe.data.difficulty]}</span>
      </div>
    </header>

    <section class="recipe-prose mb-10 max-w-none">
      <Content />
    </section>

    <section class="mb-10">
      <h2 class="mb-4 text-2xl font-serif font-bold text-warm-900">
        Ingrédients
      </h2>
      <ServingsScaler
        client:load
        ingredients={recipe.data.ingredients}
        baseServings={recipe.data.servings}
        locale={locale}
      />
    </section>

    <section>
      <h2 class="mb-6 text-2xl font-serif font-bold text-warm-900">Étapes</h2>
      <StepList steps={recipe.data.steps} locale={locale} />
    </section>
  </article>
</Layout>
