---
import Layout from "../../layouts/Layout.astro";
import RecipeCard from "../../components/RecipeCard.astro";
import { getRecipesByLocale } from "../../lib/recipes";

const locale = "fr";
const recipes = await getRecipesByLocale(locale);
---

<Layout
  title="Blog Cuisine — Recettes"
  description="Découvrez des recettes traditionnelles et leur histoire."
  locale={locale}
>
  <div class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="text-4xl font-serif font-bold text-warm-900">Recettes</h1>
    <p class="mt-2 text-lg text-warm-800">
      Des plats classiques, leurs ingrédients et l'histoire qui les accompagne.
    </p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {recipes.map((recipe) => <RecipeCard recipe={recipe} locale={locale} />)}
    </div>
  </div>
</Layout>
