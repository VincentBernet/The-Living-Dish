---
import { render } from "astro:content";
import ImageMosaic from "../../../components/ImageMosaic.astro";
import Layout from "../../../layouts/Layout.astro";
import StepList from "../../../components/StepList.astro";
import ServingsScaler from "../../../components/ServingsScaler";
import { getRecipesByLocale, getSlugFromId } from "../../../lib/recipes";

const locale = "en";

export async function getStaticPaths() {
  const recipes = await getRecipesByLocale("en");
  return recipes.map((recipe) => ({
    params: { slug: getSlugFromId(recipe.id) },
  }));
}

const { slug } = Astro.params;
const recipes = await getRecipesByLocale(locale);
const recipe = recipes.find((entry) => getSlugFromId(entry.id) === slug);

if (!recipe) {
  return Astro.redirect(`/${locale}/`);
}

const { Content } = await render(recipe);

const difficultyLabels = {
  easy: "Easy",
  medium: "Medium",
  hard: "Hard",
};

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  dateStyle: "long",
  timeZone: "UTC",
});
const publishedDate = dateFormatter.format(recipe.data.pubDate);
const updatedDate = dateFormatter.format(
  recipe.data.updatedDate ?? recipe.data.pubDate,
);
---

<Layout
  title={`${recipe.data.title} — The Living Dish`}
  description={recipe.data.description}
  image={recipe.data.socialImage ?? recipe.data.image}
  locale={locale}
>
  <article class="recipe-page mx-auto max-w-3xl px-4 py-12">
    <header class="mb-10">
      <h1 class="text-4xl font-serif font-bold text-warm-900">
        {recipe.data.title}
      </h1>
      <p class="mt-3 text-lg text-warm-800">{recipe.data.description}</p>
      <div class="mt-4 flex flex-wrap gap-4 text-sm text-warm-800">
        <span>Prep: {recipe.data.prepTime} min</span>
        <span>Cook: {recipe.data.cookTime} min</span>
        <span>{recipe.data.servings} servings</span>
        <span>{difficultyLabels[recipe.data.difficulty]}</span>
      </div>
    </header>

    {
      recipe.data.image && (
        <img
          src={recipe.data.image}
          alt={recipe.data.title}
          class="mb-10 aspect-[4/3] w-full rounded-lg object-cover"
        />
      )
    }

    <section class="recipe-prose mb-10 max-w-none">
      <Content />
    </section>

    <section class="mb-10">
      <ServingsScaler
        client:load
        ingredients={recipe.data.ingredients}
        baseServings={recipe.data.servings}
        locale={locale}
        title="Ingredients"
        ingredientsImage={recipe.data.ingredientsImage}
        imageAlt={`Ingredients for ${recipe.data.title}`}
      />
    </section>

    <section class="mt-12">
      <h2 class="mb-6 text-2xl font-serif font-bold text-warm-900">Steps</h2>
      <StepList
        steps={recipe.data.steps}
        stepImages={recipe.data.stepImages}
        locale={locale}
      />
    </section>

    {
      recipe.data.galleries.map((gallery) => (
        <ImageMosaic label={gallery.label} images={gallery.images} />
      ))
    }

    {
      recipe.data.sources.length > 0 && (
        <section class="recipe-prose mt-10 max-w-none">
          <h2>Inspiration &amp; sources</h2>
          {recipe.data.sourcesIntro && <p>{recipe.data.sourcesIntro}</p>}
          <ul>
            {recipe.data.sources.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener noreferrer">
                  {source.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <footer
      class="mt-12 flex flex-col items-end gap-4 border-t border-warm-200 pt-4 sm:flex-row sm:items-end sm:justify-between"
    >
      <div class="text-right text-sm text-warm-800 sm:text-left">
        <p>
          Published on {" "}
          <time datetime={recipe.data.pubDate.toISOString()}
            >{publishedDate}</time
          >
        </p>
        <p>
          Last edited on {" "}
          <time
            datetime={(
              recipe.data.updatedDate ?? recipe.data.pubDate
            ).toISOString()}
          >
            {updatedDate}
          </time>
        </p>
      </div>
      <p
        class="recipe-signature font-handwriting -rotate-2"
        aria-label="Signature"
      >
        Vincent Bernet
      </p>
    </footer>
  </article>
</Layout>
