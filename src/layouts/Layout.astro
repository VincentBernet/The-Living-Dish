---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { Locale } from "../lib/recipes";

interface Props {
  title: string;
  description?: string;
  image?: string;
  locale: Locale;
}

const { title, description, image, locale } = Astro.props;
const siteUrl = "https://the-living-dish.netlify.app";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const socialImage = image
  ? new URL(image, siteUrl).href
  : `${siteUrl}/images/og-image.png`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      document.documentElement.classList.add("js-enabled");

      const initializeRecipeImageFades = () => {
        document
          .querySelectorAll(".recipe-page img, .recipe-card-image")
          .forEach((image) => {
            const revealImage = () => image.classList.add("is-loaded");

            if (image.complete) {
              revealImage();
            } else {
              image.addEventListener("load", revealImage, { once: true });
              image.addEventListener("error", revealImage, { once: true });
            }
          });
      };

      const initializeRecipeImageLightboxes = () => {
        document.querySelectorAll(".recipe-page").forEach((recipePage) => {
          if (recipePage.dataset.lightboxInitialized) return;
          recipePage.dataset.lightboxInitialized = "true";

          recipePage.addEventListener("click", (event) => {
            if (!(event.target instanceof HTMLImageElement)) return;

            const image = event.target;
            const lightbox = document.createElement("div");
            const enlargedImage = document.createElement("img");

            lightbox.className = "recipe-lightbox";
            lightbox.setAttribute("role", "dialog");
            lightbox.setAttribute("aria-modal", "true");
            lightbox.setAttribute(
              "aria-label",
              image.alt ? `Enlarged image: ${image.alt}` : "Enlarged image",
            );

            enlargedImage.className = "recipe-lightbox-image";
            enlargedImage.src = image.currentSrc || image.src;
            enlargedImage.alt = image.alt;

            const revealEnlargedImage = () => {
              enlargedImage.classList.add("is-loaded");
            };

            if (enlargedImage.complete) {
              revealEnlargedImage();
            } else {
              enlargedImage.addEventListener("load", revealEnlargedImage, {
                once: true,
              });
              enlargedImage.addEventListener("error", revealEnlargedImage, {
                once: true,
              });
            }

            const closeLightbox = () => {
              document.removeEventListener("keydown", handleKeydown);
              document.body.classList.remove("recipe-lightbox-open");
              lightbox.remove();
            };

            const handleKeydown = (keyboardEvent) => {
              if (keyboardEvent.key === "Escape") closeLightbox();
            };

            lightbox.addEventListener("click", closeLightbox);

            lightbox.append(enlargedImage);
            document.body.append(lightbox);
            document.body.classList.add("recipe-lightbox-open");
            document.addEventListener("keydown", handleKeydown);
          });
        });
      };

      const initializeRecipeEnhancements = () => {
        initializeRecipeImageFades();
        initializeRecipeImageLightboxes();
      };

      if (document.readyState === "loading") {
        document.addEventListener(
          "DOMContentLoaded",
          initializeRecipeEnhancements,
        );
      } else {
        initializeRecipeEnhancements();
      }
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={title} />
    {
      /* Goatcounter, some tracking for analytics : https://vincent-bernet.goatcounter.com/ */
    }
    <script
      data-goatcounter="https://vincent-bernet.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.js"></script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header locale={locale} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
