---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { Locale } from "../lib/recipes";
import { designSystemCssVariables } from "../styles/colors";

interface Props {
  title: string;
  description?: string;
  image?: string;
  locale: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const { title, description, image, locale, alternates } = Astro.props;
const siteUrl = Astro.site ?? new URL("https://thelivingdish.com");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const socialImage = image
  ? new URL(image, siteUrl).href
  : new URL("/images/og-image.png", siteUrl).href;
const alternatePaths = alternates ?? { [locale]: Astro.url.pathname };
---

<!doctype html>
<html lang={locale} style={designSystemCssVariables}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      Object.entries(alternatePaths).map(([alternateLocale, path]) => (
        <link
          rel="alternate"
          hreflang={alternateLocale}
          href={new URL(path, siteUrl).href}
        />
      ))
    }
    <meta name="generator" content={Astro.generator} />
    <script src="../lib/footnotes.ts"></script>
    <script src="../lib/recipe-lightbox.ts"></script>
    <script is:inline>
      document.documentElement.classList.add("js-enabled");

      const initializeRecipeImageFades = () => {
        document
          .querySelectorAll(".recipe-page img, .recipe-card-image")
          .forEach((image) => {
            if (image.hasAttribute("data-react-image")) return;

            const revealImage = () => image.classList.add("is-loaded");

            if (image.complete) {
              revealImage();
            } else {
              image.addEventListener("load", revealImage, { once: true });
              image.addEventListener("error", revealImage, { once: true });
            }
          });
      };

      const initializeRecipeEnhancements = () => {
        initializeRecipeImageFades();
      };

      if (document.readyState === "loading") {
        document.addEventListener(
          "DOMContentLoaded",
          initializeRecipeEnhancements,
        );
      } else {
        initializeRecipeEnhancements();
      }
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={title} />
    {
      /* Goatcounter, some tracking for analytics : https://vincent-bernet.goatcounter.com/ */
    }
    <script
      data-goatcounter="https://vincent-bernet.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.js"></script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header locale={locale} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
